<table>
{{#each crosswords}}
  <tr>
    <td class="date">{{this.pub_date}}</td>
    <td class="variants">{{#each this.variants~}}
        {{#if (eq this "peapod")~}}
          <a href="/peapods" alt="Peapod" title="Peapod">🫛</a>{{else if (eq this "looping")~}}
          <a href="/crosswords/looping" alt="Looping Crossword" title="Looping Crossword">🔁</a>
        {{~/if}}
      {{~/each~}}
    </td>
    <td class="title">{{this.title}}</td>
    <td>{{#if this.link}}<a href="{{this.link}}">[play]</a>{{/if}}</td>
    <td>{{#if this.mirror}}<a href="{{this.mirror}}">[mirror]</a>{{/if}}</td>
    <td><a href="/crosswords/puz/{{this.download}}">[download]</a></td>
  </tr>
{{/each}}
</table>
